<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:background="#1E1E1E">

    <ImageView
        android:id="@+id/img_combo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">

        <TextView
            android:id="@+id/txt_ten_combo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OL Combo1 - Sweet 22Oz"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txt_mo_ta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01 bắp + 01 nước ngọt"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txt_gia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="76.500đ"
            android:textColor="#FFD700"
            android:textSize="15sp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_tru"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:backgroundTint="@color/red" />

            <TextView
                android:id="@+id/txt_so_luong"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_cong"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/red" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
