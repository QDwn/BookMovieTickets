<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/red"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTicketMovieTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên Phim"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvTicketDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngày: DD/MM/YYYY"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvTicketTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giờ: HH:MM"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvTicketLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rạp: Tên rạp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvTicketSeats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghế: A1, A2"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvTicketTotalAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tổng tiền: 0đ"
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>