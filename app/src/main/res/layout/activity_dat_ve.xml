<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Poster phim -->
        <ImageView
            android:id="@+id/poster_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_poster" />

        <!-- Tên phim -->
        <TextView
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TÊN PHIM"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp" />

        <!-- Ngày chiếu -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:id="@+id/date_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Địa điểm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_caugiay"
               android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="Cầu Giấy"
                android:backgroundTint="@color/red"
                android:layout_marginStart="70dp"
                android:layout_marginEnd="30dp"
                />

            <Button
                android:id="@+id/btn_dongda"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="Đống Đa"
                android:backgroundTint="@color/red"/>
        </LinearLayout>

        <!-- Cụm rạp và giờ chiếu -->
        <TextView
            android:id="@+id/txt_cum_rap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cụm rạp sẽ hiển thị ở đây"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />

        <GridLayout
            android:id="@+id/showtime_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="3"
            android:orientation="horizontal" />

        <!-- Thông báo và nút tiếp -->
        <TextView
            android:id="@+id/txt_thong_bao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF0000"
            android:layout_marginTop="12dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_tiep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tiếp"
            android:background="@color/red"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
