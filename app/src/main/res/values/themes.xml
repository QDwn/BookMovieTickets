<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.BMTADR" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="Theme.BMTADR" parent="Base.Theme.BMTADR" />

    <style name="AlertDialog.RedBlackTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/gray</item>
        <item name="android:textColorAlertDialogListItem">@color/white</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AlertDialog.Button.Positive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AlertDialog.Button.Negative</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <style name="AlertDialog.Button.Positive" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/red</item>
    </style>

    <style name="AlertDialog.Button.Negative" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/red</item>
    </style>

</resources>